# eflip server settings. Copy this file to .env (gitignored) and fill it in.
#
# The EVE_* values come from a developer application you create once at
# https://developers.eveonline.com/applications. The create form lists scopes grouped by prefix
# (esi-wallet, esi-markets, ...); expand each group and tick these seven:
#   esi-wallet.read_character_wallet.v1 esi-markets.read_character_orders.v1
#   esi-assets.read_assets.v1 esi-contracts.read_character_contracts.v1
#   esi-skills.read_skills.v1 esi-characters.read_standings.v1 esi-universe.read_structures.v1
# and the callback URL below. Without EVE_CLIENT_ID and EVE_CLIENT_SECRET the /sso routes and
# every /api route that reads synced data answer 503 "not configured"; /api/config, /api/health
# and /api/runs keep working.

# "Client ID" on the application's page.
EVE_CLIENT_ID=
# "Secret Key" on the application's page; never commit it.
EVE_CLIENT_SECRET=
# Must equal the application's "Callback URL" exactly; open eflip on this same host name.
EVE_CALLBACK_URL=http://localhost:5001/sso/callback
# Sent as User-Agent on every SSO and ESI request: CCP asks for the app name, version and a contact.
ESI_USER_AGENT=eflip/1.0 (your main character name)

# Optional.
# Where tokens.json and synced data live; default: data/ in the repo.
# EFLIP_DATA_DIR=
# Interface the server binds to; default 127.0.0.1 (local only).
# HOST=127.0.0.1
# Port the server listens on; default 5001 (must match the callback URL's port).
# PORT=5001
# Set to 1 to snapshot the destination region's whole order book once an hour while the server is up (about 388
# market-order tokens and 46 MB of orders for Domain); off by default, and meant to go with a budget (README, Syncing).
# EFLIP_REGION_BOOK=1
# Disk allotted to the bulky, replaceable data, trimmed oldest first when over; unset: nothing is trimmed (README, Storage budget).
# EFLIP_STORAGE_BUDGET=1GB
# How the budget is shared, percent by kind (the defaults); a kind under its share lends the room to the others.
# EFLIP_STORAGE_SHARES=regionPages:40,bookLogs:45,typeBooks:10,runContexts:5
# ESI X-Compatibility-Date, pinned to the date the code was checked against (newer dates exist in
# https://esi.evetech.net/meta/compatibility-dates; move the pin deliberately, not automatically).
# ESI_COMPAT_DATE=2026-08-18
